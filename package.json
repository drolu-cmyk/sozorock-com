{
  "name": "sozorockschool-homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-public-pages.mjs && vite build && node scripts/prerender-home.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify": "npm run build && npm run test:sites && npm run test:applications",
    "test:applications": "python3 -m unittest discover -s tests -p 'test_applications.py'"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "5.0.4",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.40.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "6.4.3"
  }
}
